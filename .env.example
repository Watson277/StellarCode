# Copy this file to .env. Secrets stay on the local machine and must not be committed.

# -----------------------------------------------------------------------------
# Text model (required): any OpenAI-compatible Chat Completions endpoint
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL_NAME=glm-5.3-flash

# Team-only request budgets (ReAct/Plan requests are unchanged).
# Defaults: low reasoning, planner/reviewer 4096 output tokens, worker 8192.
# An unsupported parameter is reported as an API error, never silently downgraded.
# Set TEAM_REASONING_EFFORT= (empty) if the endpoint does not support reasoning_effort.
# TEAM_REASONING_EFFORT=low
# Optional per-role override, e.g. TEAM_WORKER_REASONING_EFFORT=low
# TEAM_PLANNER_MAX_OUTPUT_TOKENS=4096
# TEAM_WORKER_MAX_OUTPUT_TOKENS=8192
# TEAM_REVIEWER_MAX_OUTPUT_TOKENS=4096
# TEAM_SUMMARY_MAX_OUTPUT_TOKENS=4096
# Set an output limit to 0 to omit it; use max_completion_tokens if required by endpoint.
# TEAM_OUTPUT_TOKEN_PARAMETER=max_tokens
# Pin a project interpreter; otherwise resolve python from Runtime PATH once per task.
# TEAM_PYTHON_EXECUTABLE=E:/envs/project/python.exe

# API keys may be left empty for a keyless local endpoint.
# LLM_INPUT_COST_PER_MILLION=0.00
# LLM_CACHED_INPUT_COST_PER_MILLION=0.00
# LLM_OUTPUT_COST_PER_MILLION=0.00
# LLM_COST_CURRENCY=USD

# -----------------------------------------------------------------------------
# Vision model (optional): leave URL and model empty to disable image routing
# -----------------------------------------------------------------------------
# VISION_API_KEY=your_vision_api_key
# VISION_BASE_URL=https://your-vision-endpoint.example/v1
# VISION_MODEL_NAME=your_vision_model_name

# -----------------------------------------------------------------------------
# Embedding model for Code RAG (optional)
# -----------------------------------------------------------------------------
# Leave EMBEDDING_BASE_URL empty to use deterministic local hashing. A remote
# endpoint must expose the OpenAI-compatible /embeddings API. Ollama can use /v1.
# EMBEDDING_API_KEY=your_embedding_api_key
# EMBEDDING_BASE_URL=https://your-embedding-endpoint.example/v1
# EMBEDDING_MODEL_NAME=your_embedding_model_name

# Optional SQLite index directory. Default: ~/.stellarcode/rag
# STELLARCODE_RAG_DIR=.stellarcode-rag

# -----------------------------------------------------------------------------
# Web search (optional and independent from model endpoints)
# -----------------------------------------------------------------------------
# SEARCH_PROVIDER=zhipu
# ZHIPU_SEARCH_ENGINE=search_std
# SERPAPI_KEY=your_serpapi_key
# SEARXNG_URL=http://localhost:8888

# -----------------------------------------------------------------------------
# MCP secrets (optional)
# -----------------------------------------------------------------------------
# MCP_API_KEY=your_mcp_server_token
# UAPI_TOKEN=your_weather_service_token

# Provider-prefixed variables from older releases are read only as a migration
# fallback. New configurations do not use or require a provider field.

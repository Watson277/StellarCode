# Copy this file to .env and configure one provider.
LLM_PROVIDER=deepseek

# DeepSeek provider (text and tool calls; image blocks are omitted).
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional cost overrides in currency units per 1M tokens. StellarCode includes an
# official USD price table for exact deepseek-v4-flash / deepseek-v4-pro model names.
# Configure these for a proxy, a custom model, GLM, or Agnes. Provider-prefixed values
# (for example GLM_INPUT_COST_PER_MILLION) take priority over the generic LLM values.
# LLM_INPUT_COST_PER_MILLION=0.00
# LLM_CACHED_INPUT_COST_PER_MILLION=0.00
# LLM_OUTPUT_COST_PER_MILLION=0.00
# LLM_COST_CURRENCY=USD

# Optional cross-provider vision routing. Text stays on LLM_PROVIDER; image-bearing turns
# use the selected VLM and return to the text model after historical images are pruned.
VISION_PROVIDER=glm

# GLM provider.
GLM_API_KEY=your_glm_api_key_here

# Optional overrides.
GLM_MODEL=glm-5.1
# Image messages automatically use this model; normal messages keep GLM_MODEL.
GLM_VISION_MODEL=glm-5v-turbo
# Optional: use a standard BigModel API key for vision when GLM_API_KEY belongs to a
# Coding Plan that cannot call the standard multimodal endpoint.
# GLM_VISION_API_KEY=your_standard_bigmodel_api_key_here
# Leave the URL unset so each request selects the coding or multimodal endpoint.
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Agnes provider. Set LLM_PROVIDER=agnes to use it for both text and images.
# The endpoint is OpenAI Chat Completions compatible.
AGNES_API_KEY=your_agnes_api_key_here
AGNES_MODEL=agnes-2.0-flash
AGNES_VISION_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Web search. If SEARCH_PROVIDER is omitted, StellarCode auto-selects the first configured
# provider in this order: Zhipu, SerpAPI, SearXNG.
SEARCH_PROVIDER=zhipu
ZHIPU_SEARCH_ENGINE=search_std
# SERPAPI_KEY=your_serpapi_key_here
# SEARXNG_URL=http://localhost:8888
# Off-topic primary results automatically fall back to other configured providers and
# then the no-key Wikimedia API.

# Optional token referenced by docs/mcp.example.json as ${MCP_API_KEY}.
# MCP_API_KEY=your_mcp_server_token_here

# UAPI weather MCP server. Create a token at https://uapis.cn.
# UAPI_TOKEN=your_uapi_token_here

# Code RAG embeddings. The PDF chapter uses Ollama by default.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_API_KEY=your_embedding_api_key_here

# Optional SQLite index directory. Default: ~/.stellarcode/rag
# STELLARCODE_RAG_DIR=.stellarcode-rag
